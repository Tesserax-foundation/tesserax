# Supabase project of the explorer (Project Settings > API). The anon key is public: row level
# security limits it to reading.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Name of the network shown in the header: Mainnet, Testnet or Development.
VITE_NETWORK=Testnet
