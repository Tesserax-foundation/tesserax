# Websocket RPC of a Tesserax node, archive mode recommended (--state-pruning archive).
NODE_URL=ws://127.0.0.1:9944
# Postgres connection string of the Supabase project, through the session pooler (Project Settings >
# Database > Connection string). Use the explorer_indexer role of the migrations, which can only
# write the explorer's tables, with the password set in supabase/roles.sql. It writes: keep it secret.
DATABASE_URL=postgresql://explorer_indexer.YOUR-PROJECT:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
# Prepared statements pipeline the writes (one round trip per batch of blocks). The session pooler
# (port 5432) supports them; set to false with the transaction pooler (port 6543).
DATABASE_PREPARE=true
# Blocks fetched in parallel while catching up.
BATCH=16
LOG_LEVEL=info
