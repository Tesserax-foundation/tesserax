# Node of the devnet on a host that gives an image build only minutes, such as Railway: the image
# holds the sources and the toolchain, and the node is compiled when the container starts, into
# the volume, then run (docker/devnet-node.sh). A container started again on the same sources
# starts at once. See docs/devnet.md.
#
#   docker build -f docker/Dockerfile.devnet -t tesserax-devnet .
#   docker run -v tesserax-data:/data -p 30333:30333 tesserax-devnet --chain /build/chain-specs/devnet.json --base-path /data

FROM docker.io/library/rust:1.99.1-bookworm@sha256:48b7f435b8fc6378ce43b44f15e3a47fd8919b2825f835c39bd4bd3da50af5b8

RUN apt-get update \
	&& apt-get install -y --no-install-recommends clang libclang-dev protobuf-compiler cmake pkg-config \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY rust-toolchain.toml ./
RUN rustup toolchain install
COPY . .
# Identifies the sources, so that a binary compiled from other sources is never reused.
RUN find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -c1-16 > /build/.source-id

# Peer-to-peer, RPC, Prometheus, stratum of the node.
EXPOSE 30333 9944 9615 3333

ENTRYPOINT ["/build/docker/devnet-node.sh"]
CMD ["--chain", "/build/chain-specs/devnet.json", "--base-path", "/data"]
