# A binary of the repository compiled when the container starts, for hosts that give an image
# build only minutes: the image holds the sources and the toolchain, and docker/from-source.sh
# compiles the package into the volume, then runs it. A container started again on the same
# sources starts at once.
#
#   docker build -f docker/Dockerfile.from-source -t tesserax-from-source .
#   docker run -v tesserax-data:/data -p 30333:30333 tesserax-from-source --chain testnet --base-path /data
#   docker run -v faucet-data:/data -e PACKAGE=tesserax-faucet -e BINARY=tesserax-faucet tesserax-from-source

FROM docker.io/library/rust:1.99.1-bookworm@sha256:48b7f435b8fc6378ce43b44f15e3a47fd8919b2825f835c39bd4bd3da50af5b8

RUN apt-get update \
	&& apt-get install -y --no-install-recommends clang libclang-dev protobuf-compiler cmake pkg-config \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY rust-toolchain.toml ./
RUN rustup toolchain install
COPY . .
# Identifies the sources, so that a binary compiled from other sources is never reused.
RUN find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -c1-16 > /build/.source-id

# Peer-to-peer, RPC, Prometheus, stratum of the node; HTTP of the faucet.
EXPOSE 30333 9944 9615 3333 8080

ENTRYPOINT ["/build/docker/from-source.sh"]
CMD ["--chain", "testnet", "--base-path", "/data"]
